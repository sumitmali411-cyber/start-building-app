# Copy to .env (git-ignored) and fill in. Never commit real values.

# Database
DB_USERNAME=sa
DB_PASSWORD=

# Enable the H2 web console for local debugging only. Never true in production.
H2_CONSOLE_ENABLED=false

# Payment provider credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ADUMO_MERCHANT_ID=

# JWT signing secret for flow sessions.
# Generate with: openssl rand -base64 48
FLOW_JWT_SECRET=

# Origin allowed by CORS and as a payment redirect target
FRONTEND_ORIGIN=http://localhost:4200
